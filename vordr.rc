/* application / window icon (lowest ID -> the shell's file icon) */
1 ICON "vordr.ico"

DLG_UNLOCK DIALOGEX 0, 0, 320, 104
STYLE  DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Unlock vault"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Storage location:", -1, 12, 13, 66, 10
    CONTROL         "", IDC_U_PATH, "Button", BS_OWNERDRAW | WS_TABSTOP, 80, 9, 228, 16
    EDITTEXT        IDC_U_PW, 12, 40, 296, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "Unlock", IDC_U_UNLOCK, 254, 70, 54, 18, BS_OWNERDRAW
    LTEXT           "", IDC_U_STATUS, 12, 74, 232, 24
END

DLG_VAULT DIALOGEX 0, 0, 484, 350
CAPTION "Vordr - Vault"
STYLE DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    PUSHBUTTON "+", IDC_V_ADD, 5, 42, 16, 16, BS_OWNERDRAW
    PUSHBUTTON "e", IDC_V_EDIT, 5, 61, 16, 16, BS_OWNERDRAW
    PUSHBUTTON "-", IDC_V_REMOVE, 5, 290, 16, 16, BS_OWNERDRAW
    LISTBOX IDC_V_LIST, 30, 10, 174, 280, LBS_SORT | LBS_OWNERDRAWVARIABLE | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    EDITTEXT IDC_V_SEARCH, 30, 292, 174, 13, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_V_HEADER, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 216, 6, 216, 42
    PUSHBUTTON "", IDC_V_FAV, 436, 12, 16, 14, BS_OWNERDRAW
    PUSHBUTTON "", IDC_V_OVFL, 456, 12, 16, 14, BS_OWNERDRAW
    PUSHBUTTON "", IDC_V_ICON, 216, 8, 22, 18, BS_OWNERDRAW | WS_TABSTOP
    EDITTEXT IDC_V_TITLE, 246, 13, 228, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER , 0
    LTEXT "", IDC_V_TIMES, 222, 52, 244, 10
    PUSHBUTTON "+ Add field", IDC_V_ADDFIELD, 216, 292, 64, 14, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDC_V_CANCEL, 362, 292, 54, 14, BS_OWNERDRAW
    PUSHBUTTON "Save", IDC_V_SAVE, 420, 292, 54, 14, BS_OWNERDRAW
    PUSHBUTTON "Lock", IDC_V_LOCK, 420, 320, 54, 18, BS_OWNERDRAW
    CONTROL "", IDC_V_COLORPW, "Static", SS_OWNERDRAW | WS_CHILD, 222, 100, 196, 12
    CONTROL "", IDC_V_MBACK, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 0, 0, 484, 350
    LTEXT "Settings", IDC_V_MTITLE, 30, 16, 200, 14
    LTEXT "Password policy", IDC_V_MPOLL, 30, 44, 360, 10
    LTEXT "Minimum length:", IDC_V_MLENL, 44, 60, 120, 10
    EDITTEXT IDC_V_MLEN, 170, 59, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    LTEXT "Minimum character types (1-4):", IDC_V_MCLSL, 44, 78, 120, 10
    EDITTEXT IDC_V_MCLS, 170, 77, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    LTEXT "TPM Unlock", IDC_V_MTPML, 30, 112, 56, 10
    PUSHBUTTON "i", IDC_V_MTPMINFO, 70, 112, 8, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    PUSHBUTTON "", IDC_V_MTPM, 170, 112, 20, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "Secure unlock", IDC_V_MSECDL, 30, 124, 130, 10
    PUSHBUTTON "i", IDC_V_MSECINFO, 74, 124, 8, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    PUSHBUTTON "", IDC_V_MSECD, 170, 124, 20, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "Disable phonetic reader", IDC_V_MNOPHONL, 30, 136, 130, 10
    PUSHBUTTON "", IDC_V_MNOPHON, 170, 136, 20, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "Do not save history", IDC_V_MNOHISTL, 30, 148, 130, 10
    PUSHBUTTON "", IDC_V_MNOHIST, 170, 148, 20, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "Lock when Windows locks", IDC_V_MWLKL, 30, 160, 130, 10
    PUSHBUTTON "", IDC_V_MWLK, 170, 160, 20, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "Clipboard clear (seconds, 0=off):", IDC_V_MCLIPL, 30, 172, 130, 10
    EDITTEXT IDC_V_MCLIP, 170, 171, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    LTEXT "Auto-lock idle (minutes, 0=off):", IDC_V_MIDLEL, 30, 184, 130, 10
    EDITTEXT IDC_V_MIDLE, 170, 183, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    LTEXT "Color scheme", IDC_V_MTHEMEL, 30, 196, 90, 10
    PUSHBUTTON "Dark", IDC_V_MTHEME, 130, 196, 96, 14, BS_OWNERDRAW
    PUSHBUTTON "Import secrets...", IDC_V_MIMPORT, 30, 300, 110, 14, BS_OWNERDRAW
    PUSHBUTTON "Export secrets...", IDC_V_MEXPORT, 30, 320, 110, 14, BS_OWNERDRAW
    PUSHBUTTON "=", IDC_V_MENU, 5, 7, 16, 16, BS_OWNERDRAW
}

DLG_CREATE DIALOGEX 0, 0, 300, 292
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Set master password"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_C_LOGO, "Static", SS_ICON | WS_CHILD | WS_VISIBLE, 129, 14, 44, 44
    LTEXT           "", IDC_C_WELCOME, 22, 62, 256, 150, SS_LEFT
    EDITTEXT        IDC_C_PW, 24, 222, 212, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "i", IDC_C_INFO, 242, 221, 14, 14, BS_OWNERDRAW | NOT WS_TABSTOP
    EDITTEXT        IDC_C_PW2, 24, 240, 212, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "Create", IDOK, 210, 264, 54, 18, BS_OWNERDRAW
END

DLG_XLPW DIALOGEX 0, 0, 264, 130
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Export all secrets"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "This writes EVERY entry (including passwords and TOTP secrets) into one Excel file, protected only by the password you choose below. Store it safely and delete it when done.", IDC_XP_WARN, 16, 12, 232, 40, 0
    EDITTEXT IDC_XP_PW, 16, 60, 232, 12, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    EDITTEXT IDC_XP_PW2, 16, 80, 232, 12, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON "Export", IDOK, 134, 104, 54, 18, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDCANCEL, 194, 104, 54, 18, BS_OWNERDRAW
END

DLG_IMPPW DIALOGEX 0, 0, 264, 100
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Import"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "This file is password-protected. Enter the password used to protect it to unlock and import its contents.", IDC_XP_WARN, 16, 12, 232, 32, 0
    EDITTEXT IDC_XP_PW, 16, 52, 232, 12, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON "Import", IDOK, 134, 74, 54, 18, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDCANCEL, 194, 74, 54, 18, BS_OWNERDRAW
END

DLG_SELECT DIALOGEX 0, 0, 300, 296
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Select entries to export"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_SEL_SEARCH, 8, 8, 284, 12, ES_AUTOHSCROLL | NOT WS_BORDER, 0
    CONTROL "", IDC_SEL_LIST, WC_LISTVIEW, LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 8, 26, 284, 232
    PUSHBUTTON "All", IDC_SEL_ALL, 8, 264, 46, 16, BS_OWNERDRAW
    PUSHBUTTON "None", IDC_SEL_NONE, 58, 264, 46, 16, BS_OWNERDRAW
    PUSHBUTTON "Export", IDOK, 180, 264, 54, 16, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDCANCEL, 238, 264, 54, 16, BS_OWNERDRAW
END

