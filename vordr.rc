#define IDC_V_MTITLE 218
#define IDC_V_MPOLL  219
#define IDC_V_MLENL  220
#define IDC_V_MLEN   221
#define IDC_V_MCLSL  222
#define IDC_V_MCLS   223
#define IDC_V_MTPM   224
#define IDC_V_MTPMINFO 226
#define IDC_V_MTPML  228
#define IDC_V_MTHEME 240
#define IDC_V_MTHEMEL 241
#define IDC_V_MLAYOUT 242
#define IDC_V_MLAYOUTL 243
#define IDC_V_COLORPW 244
#define IDC_V_MEXPORT 245
#define IDC_V_MIMPCSV 246
#define IDC_V_MEXPZIP 247
#define IDC_V_MIMPXLS 248
#define DLG_PWGEN    760
#define IDC_PG_OUT   761
#define IDC_PG_REGEN 762
#define IDC_PG_BITS  763
#define IDC_PG_LENL  764
#define IDC_PG_LEN   765
#define IDC_PG_LENVAL 766
#define IDC_PG_STYLE 767
#define IDC_PG_UP    768
#define IDC_PG_LO    769
#define IDC_PG_DI    770
#define IDC_PG_SY    771
#define IDC_PG_AMB   772
#define DLG_XLPW     720
#define IDC_XP_PW    721
#define IDC_XP_PW2   722
#define IDC_XP_WARN  723
#define IDC_XP_PWL   724
#define IDC_XP_PW2L  725
#define DLG_IMPPW    730
#define DLG_CREATE   400
#define IDC_C_PW     402
#define IDC_C_PW2    403
#define IDC_C_PWBAR  404
#define IDC_C_PW2BAR 405
#define IDC_C_INFO   406
#define DLG_MSG      600
#define IDC_M_TEXT   601
#define IDC_M_OK     602
#define IDC_M_NO     603
#define DLG_ABOUT    610
