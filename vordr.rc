/* vordr.rc - app icon, VERSIONINFO, and the GUI dialog templates for
   bin\vordr.exe (compiled by rc.exe in build.cmd, then linked in). */
#include <windows.h>

/* control IDs - MUST match the equ values in src/gui.asm */
#define DLG_UNLOCK   100
#define IDC_U_PATH   101
#define IDC_U_OPEN   102
#define IDC_U_NEW    103
#define IDC_U_PW     104
#define IDC_U_UNLOCK 105
#define IDC_U_STATUS 106
#define IDC_U_TPM    107
#define IDC_U_REMEMBER 108
#define DLG_VAULT    200
#define IDC_V_LIST   201
#define IDC_V_TITLE  202
#define IDC_V_USER   203
#define IDC_V_SECRET 204
#define IDC_V_URL    205
#define IDC_V_NOTES  206
#define IDC_V_REVEAL 207
#define IDC_V_COPY   208
#define IDC_V_ADD    209
#define IDC_V_EDIT   210
#define IDC_V_REMOVE 211
#define IDC_V_LOCK   212
#define IDC_V_TOTP   213
#define IDC_V_COPYTOTP 214
#define IDC_V_TKEY   227
#define IDC_V_MENU   216
#define IDC_V_MBACK  217
#define IDC_V_MTITLE 218
#define IDC_V_MPOLL  219
#define IDC_V_MLENL  220
#define IDC_V_MLEN   221
#define IDC_V_MCLSL  222
#define IDC_V_MCLS   223
#define IDC_V_MTPM   224
#define IDC_V_MTPMINFO 226
#define DLG_CREATE   400
#define IDC_C_PW     402
#define IDC_C_PW2    403
#define IDC_C_PWBAR  404
#define IDC_C_PW2BAR 405
#define IDC_C_INFO   406

/* application / window icon (lowest ID -> the shell's file icon) */
1 ICON "vordr.ico"

DLG_UNLOCK DIALOGEX 0, 0, 320, 104
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Unlock vault"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Vault file:", -1, 12, 12, 50, 10
    LTEXT           "(no vault selected)", IDC_U_PATH, 66, 12, 242, 10
    EDITTEXT        IDC_U_PW, 12, 40, 296, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "Unlock", IDC_U_UNLOCK, 254, 70, 54, 18, BS_OWNERDRAW
    LTEXT           "", IDC_U_STATUS, 12, 74, 232, 24
END

DLG_VAULT DIALOGEX 0, 0, 426, 286
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Vault"
FONT 9, "Segoe UI"
BEGIN
    /* ---- left-margin toolbar: add (+), edit (pencil), remove (-) ---------- */
    PUSHBUTTON      "+", IDC_V_ADD, 6, 36, 18, 18, BS_OWNERDRAW
    PUSHBUTTON      "e", IDC_V_EDIT, 6, 58, 18, 18, BS_OWNERDRAW
    PUSHBUTTON      "-", IDC_V_REMOVE, 6, 80, 18, 18, BS_OWNERDRAW
    LISTBOX         IDC_V_LIST, 30, 10, 116, 240, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT           "Title", -1, 158, 14, 44, 10
    EDITTEXT        IDC_V_TITLE, 206, 13, 210, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT           "Username", -1, 158, 34, 44, 10
    EDITTEXT        IDC_V_USER, 206, 33, 210, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT           "Secret", -1, 158, 54, 44, 10
    EDITTEXT        IDC_V_SECRET, 206, 53, 150, 11, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    PUSHBUTTON      "Reveal", IDC_V_REVEAL, 358, 52, 28, 13, BS_OWNERDRAW | NOT WS_TABSTOP
    PUSHBUTTON      "Copy", IDC_V_COPY, 388, 52, 28, 13, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT           "URL", -1, 158, 74, 44, 10
    EDITTEXT        IDC_V_URL, 206, 73, 210, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT           "Notes", -1, 158, 94, 44, 10
    EDITTEXT        IDC_V_NOTES, 206, 92, 210, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT           "TOTP key", -1, 158, 140, 44, 10
    EDITTEXT        IDC_V_TKEY, 206, 139, 210, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    LTEXT           "Auth code", -1, 158, 160, 44, 10
    EDITTEXT        IDC_V_TOTP, 206, 159, 110, 11, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP | NOT WS_BORDER, 0
    PUSHBUTTON      "Copy code", IDC_V_COPYTOTP, 320, 158, 56, 13, BS_OWNERDRAW | NOT WS_TABSTOP
    PUSHBUTTON      "Lock", IDC_V_LOCK, 362, 256, 54, 18, BS_OWNERDRAW

    /* ---- settings overlay (hidden until the burger is clicked) ----------- */
    CONTROL         "", IDC_V_MBACK, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 0, 0, 426, 286
    LTEXT           "Settings", IDC_V_MTITLE, 30, 16, 200, 14
    LTEXT           "Password policy", IDC_V_MPOLL, 30, 44, 360, 10
    LTEXT           "Minimum length:", IDC_V_MLENL, 44, 60, 120, 10
    EDITTEXT        IDC_V_MLEN, 170, 59, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    LTEXT           "Minimum character types (1-4):", IDC_V_MCLSL, 44, 78, 120, 10
    EDITTEXT        IDC_V_MCLS, 170, 77, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    AUTOCHECKBOX    "TPM Unlock", IDC_V_MTPM, 30, 112, 70, 12
    PUSHBUTTON      "i", IDC_V_MTPMINFO, 104, 110, 14, 14, BS_OWNERDRAW

    /* ---- burger menu (top-left, last = always on top of the overlay) ------ */
    PUSHBUTTON      "=", IDC_V_MENU, 6, 12, 18, 16, BS_OWNERDRAW
END

DLG_CREATE DIALOGEX 0, 0, 228, 108
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Create vault"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_C_PW, 16, 24, 176, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "i", IDC_C_INFO, 198, 23, 14, 14, BS_OWNERDRAW | NOT WS_TABSTOP
    CONTROL         "", IDC_C_PWBAR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 40, 176, 3
    EDITTEXT        IDC_C_PW2, 16, 52, 176, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    CONTROL         "", IDC_C_PW2BAR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 68, 176, 3
    PUSHBUTTON      "Create", IDOK, 158, 82, 54, 18, BS_OWNERDRAW
END

1 VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L            /* VOS_NT_WINDOWS32 */
 FILETYPE       0x1L                /* VFT_APP */
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"           /* US English (0x0409), Unicode (1200) */
        BEGIN
            VALUE "CompanyName",      "Thomas Smistad"
            VALUE "FileDescription",  "Vordr - hardened password manager (AES-256-GCM + Argon2id)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "vordr"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Thomas Smistad"
            VALUE "OriginalFilename", "vordr.exe"
            VALUE "ProductName",      "Vordr"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
