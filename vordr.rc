/* application / window icon (lowest ID -> the shell's file icon) */
1 ICON "vordr.ico"

DLG_UNLOCK DIALOGEX 0, 0, 320, 104
STYLE  WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Unlock vault"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Vault file:", -1, 12, 12, 50, 10
    LTEXT           "(no vault selected)", IDC_U_PATH, 66, 12, 242, 10
    EDITTEXT        IDC_U_PW, 12, 40, 296, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "Unlock", IDC_U_UNLOCK, 254, 70, 54, 18, BS_OWNERDRAW
    LTEXT           "", IDC_U_STATUS, 12, 74, 232, 24
END

DLG_VAULT DIALOGEX 0, 0, 484, 350
CAPTION "Vordr - Vault"
STYLE DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    PUSHBUTTON "+", IDC_V_ADD, 5, 42, 16, 16, BS_OWNERDRAW
    PUSHBUTTON "e", IDC_V_EDIT, 5, 61, 16, 16, BS_OWNERDRAW
    PUSHBUTTON "-", IDC_V_REMOVE, 5, 290, 16, 16, BS_OWNERDRAW
    LISTBOX IDC_V_LIST, 30, 10, 174, 280, LBS_SORT | LBS_OWNERDRAWVARIABLE | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    EDITTEXT IDC_V_SEARCH, 30, 292, 174, 13, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_V_HEADER, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 216, 6, 216, 42
    PUSHBUTTON "", IDC_V_FAV, 436, 12, 16, 14, BS_OWNERDRAW
    PUSHBUTTON "", IDC_V_OVFL, 456, 12, 16, 14, BS_OWNERDRAW
    LTEXT "Title", IDC_V_TITLELBL, 216, 14, 44, 10
    EDITTEXT IDC_V_TITLE, 264, 13, 210, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER , 0
    LTEXT "", IDC_V_TIMES, 222, 52, 244, 10
    PUSHBUTTON "+ Add field", IDC_V_ADDFIELD, 216, 292, 64, 14, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDC_V_CANCEL, 362, 292, 54, 14, BS_OWNERDRAW
    PUSHBUTTON "Save", IDC_V_SAVE, 420, 292, 54, 14, BS_OWNERDRAW
    PUSHBUTTON "Lock", IDC_V_LOCK, 420, 320, 54, 18, BS_OWNERDRAW
    CONTROL "", IDC_V_COLORPW, "Static", SS_OWNERDRAW | WS_CHILD, 222, 100, 196, 12
    CONTROL "", IDC_V_MBACK, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 0, 0, 484, 350
    LTEXT "Settings", IDC_V_MTITLE, 30, 16, 200, 14
    LTEXT "Password policy", IDC_V_MPOLL, 30, 44, 360, 10
    LTEXT "Minimum length:", IDC_V_MLENL, 44, 60, 120, 10
    EDITTEXT IDC_V_MLEN, 170, 59, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    LTEXT "Minimum character types (1-4):", IDC_V_MCLSL, 44, 78, 120, 10
    EDITTEXT IDC_V_MCLS, 170, 77, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    PUSHBUTTON "", IDC_V_MTPM, 170, 115, 20, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "TPM Unlock", IDC_V_MTPML, 30, 115, 56, 10
    PUSHBUTTON "i", IDC_V_MTPMINFO, 70, 115, 8, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "Color scheme", IDC_V_MTHEMEL, 30, 140, 90, 10
    PUSHBUTTON "Dark", IDC_V_MTHEME, 130, 138, 96, 14, BS_OWNERDRAW
    LTEXT "Layout", IDC_V_MLAYOUTL, 30, 162, 90, 10
    PUSHBUTTON "Comfortable", IDC_V_MLAYOUT, 130, 160, 96, 14, BS_OWNERDRAW
    PUSHBUTTON "Export all secrets to Excel...", IDC_V_MEXPORT, 30, 184, 196, 16, BS_OWNERDRAW
    PUSHBUTTON "Import from CSV...", IDC_V_MIMPCSV, 30, 204, 196, 16, BS_OWNERDRAW
    PUSHBUTTON "Import from Excel...", IDC_V_MIMPXLS, 30, 224, 196, 16, BS_OWNERDRAW
    PUSHBUTTON "Export to encrypted ZIP...", IDC_V_MEXPZIP, 30, 244, 196, 16, BS_OWNERDRAW
    PUSHBUTTON "=", IDC_V_MENU, 5, 7, 16, 16, BS_OWNERDRAW
}

DLG_CREATE DIALOGEX 0, 0, 228, 108
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Create vault"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_C_PW, 16, 24, 176, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "i", IDC_C_INFO, 198, 23, 14, 14, BS_OWNERDRAW | NOT WS_TABSTOP
    CONTROL         "", IDC_C_PWBAR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 40, 176, 3
    EDITTEXT        IDC_C_PW2, 16, 52, 176, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    CONTROL         "", IDC_C_PW2BAR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 68, 176, 3
    PUSHBUTTON      "Create", IDOK, 158, 82, 54, 18, BS_OWNERDRAW
END

DLG_XLPW DIALOGEX 0, 0, 264, 156
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Export all secrets"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "This writes EVERY entry (including passwords and TOTP secrets) into one Excel file, protected only by the password you choose below. Store it safely and delete it when done.", IDC_XP_WARN, 16, 12, 232, 40, 0
    LTEXT "Export password:", IDC_XP_PWL, 16, 60, 120, 10
    EDITTEXT IDC_XP_PW, 16, 72, 232, 12, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    LTEXT "Confirm password:", IDC_XP_PW2L, 16, 92, 120, 10
    EDITTEXT IDC_XP_PW2, 16, 104, 232, 12, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON "Export", IDOK, 134, 130, 54, 18, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDCANCEL, 194, 130, 54, 18, BS_OWNERDRAW
END

DLG_IMPPW DIALOGEX 0, 0, 264, 112
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Import from Excel"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "This Excel workbook is password-protected. Enter the password used to protect it to unlock and import its entries.", IDC_XP_WARN, 16, 12, 232, 32, 0
    LTEXT "Workbook password:", IDC_XP_PWL, 16, 50, 120, 10
    EDITTEXT IDC_XP_PW, 16, 62, 232, 12, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON "Import", IDOK, 134, 86, 54, 18, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDCANCEL, 194, 86, 54, 18, BS_OWNERDRAW
END

DLG_PWGEN DIALOGEX 0, 0, 260, 200
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Password generator"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT   IDC_PG_OUT, 16, 16, 196, 16, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER, 0
    PUSHBUTTON "Regen", IDC_PG_REGEN, 216, 16, 28, 16, BS_OWNERDRAW
    LTEXT      "", IDC_PG_BITS, 16, 36, 228, 10
    LTEXT      "Length", IDC_PG_LENL, 16, 54, 34, 10
    CONTROL    "", IDC_PG_LEN, "msctls_trackbar32", 0x50000000, 52, 50, 158, 18
    LTEXT      "16", IDC_PG_LENVAL, 216, 54, 28, 10
    PUSHBUTTON "Style: Random", IDC_PG_STYLE, 16, 72, 228, 16, BS_OWNERDRAW
    PUSHBUTTON "Uppercase", IDC_PG_UP, 16, 94, 111, 16, BS_OWNERDRAW
    PUSHBUTTON "Lowercase", IDC_PG_LO, 133, 94, 111, 16, BS_OWNERDRAW
    PUSHBUTTON "Digits", IDC_PG_DI, 16, 114, 111, 16, BS_OWNERDRAW
    PUSHBUTTON "Symbols", IDC_PG_SY, 133, 114, 111, 16, BS_OWNERDRAW
    PUSHBUTTON "Avoid ambiguous", IDC_PG_AMB, 16, 134, 228, 16, BS_OWNERDRAW
    PUSHBUTTON "Use", IDOK, 130, 168, 54, 18, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDCANCEL, 190, 168, 54, 18, BS_OWNERDRAW
END

DLG_MSG DIALOGEX 0, 0, 268, 142
CAPTION "Vordr"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    LTEXT "", IDC_M_TEXT, 20, 18, 228, 84, 0
    PUSHBUTTON "OK", IDC_M_OK, 132, 112, 56, 22, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDC_M_NO, 192, 112, 56, 22, BS_OWNERDRAW
}

DLG_ABOUT DIALOGEX 0, 0, 272, 132
CAPTION "About Vordr"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    CONTROL "", IDC_A_ICON, "Static", SS_ICON | WS_CHILD | WS_VISIBLE , 22 , 24 , 24 , 24
    LTEXT "", IDC_A_TEXT, 80, 24, 172, 78
    PUSHBUTTON "OK", IDC_A_OK, 214, 104, 56, 22, BS_OWNERDRAW
}

DLG_IMGVIEW DIALOGEX 0, 0, 400, 322
CAPTION "Vordr - Image"
STYLE DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    CONTROL "", IDC_IV_PIC, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 8, 8, 384, 282
    PUSHBUTTON "Export", IDC_IV_EXPORT, 280, 298, 54, 18, BS_OWNERDRAW
    PUSHBUTTON "Close", IDOK, 338, 298, 54, 18, BS_OWNERDRAW
}

DLG_PWREAD DIALOGEX 0, 0, 300, 360
CAPTION "Vordr - Read password"
STYLE DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    CONTROL "", IDC_PR_COLOR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 12, 12, 276, 34
    CONTROL "", IDC_PR_LEGEND, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 12, 50, 276, 12
    CONTROL "", IDC_PR_PHON, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 12, 68, 276, 284
    PUSHBUTTON "Close", IDOK, 234, 336, 54, 16, BS_OWNERDRAW
}

1 VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L            /* VOS_NT_WINDOWS32 */
 FILETYPE       0x1L                /* VFT_APP */
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"           /* US English (0x0409), Unicode (1200) */
        BEGIN
            VALUE "CompanyName",      "Thomas Smistad"
            VALUE "FileDescription",  "Vordr - hardened password manager (AES-256-GCM + Argon2id)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "vordr"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Thomas Smistad"
            VALUE "OriginalFilename", "vordr.exe"
            VALUE "ProductName",      "Vordr"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
