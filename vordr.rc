/* vordr.rc - app icon, VERSIONINFO, and the GUI dialog templates for
   bin\vordr.exe (compiled by rc.exe in build.cmd, then linked in). */
#include <windows.h>

/* control IDs - MUST match the equ values in src/gui.asm */
#define DLG_UNLOCK   100
#define IDC_U_PATH   101
#define IDC_U_OPEN   102
#define IDC_U_NEW    103
#define IDC_U_PW     104
#define IDC_U_UNLOCK 105
#define IDC_U_STATUS 106
#define IDC_U_TPM    107
#define IDC_U_REMEMBER 108
#define DLG_VAULT    200
#define IDC_V_LIST   201
#define IDC_V_TITLE  202
#define IDC_V_USER   203
#define IDC_V_SECRET 204
#define IDC_V_URL    205
#define IDC_V_NOTES  206
#define IDC_V_REVEAL 207
#define IDC_V_COPY   208
#define IDC_V_ADD    209
#define IDC_V_EDIT   210
#define IDC_V_REMOVE 211
#define IDC_V_LOCK   212
#define IDC_V_TOTP   213
#define IDC_V_COPYTOTP 214
#define IDC_V_TOTPBAR 215
#define IDC_V_TKEY   227
#define IDC_V_TKEYREVEAL 229
#define IDC_V_ADDFIELD 230
#define IDC_V_SAVE   231
#define IDC_V_SEARCH 232
#define IDC_V_HEADER 233
#define IDC_V_TITLELBL 234
#define IDC_V_OVFL   235
#define IDC_V_TIMES  236
#define IDC_V_FAV    237
#define IDC_V_MENU   216
#define IDC_V_MBACK  217
#define IDC_V_MTITLE 218
#define IDC_V_MPOLL  219
#define IDC_V_MLENL  220
#define IDC_V_MLEN   221
#define IDC_V_MCLSL  222
#define IDC_V_MCLS   223
#define IDC_V_MTPM   224
#define IDC_V_MTPMINFO 226
#define IDC_V_MTPML  228
#define IDC_V_MTHEME 240
#define IDC_V_MTHEMEL 241
#define IDC_V_MLAYOUT 242
#define IDC_V_MLAYOUTL 243
#define DLG_CREATE   400
#define IDC_C_PW     402
#define IDC_C_PW2    403
#define IDC_C_PWBAR  404
#define IDC_C_PW2BAR 405
#define IDC_C_INFO   406
#define DLG_MSG      600
#define IDC_M_TEXT   601
#define IDC_M_OK     602
#define IDC_M_NO     603
#define DLG_ABOUT    610
#define IDC_A_ICON   611
#define IDC_A_TEXT   612
#define IDC_A_OK     613
#define DLG_IMGVIEW  620
#define IDC_IV_PIC   621
#define IDC_IV_EXPORT 622
#define DLG_PWREAD   700
#define IDC_PR_COLOR 701
#define IDC_PR_LEGEND 702
#define IDC_PR_PHON  703

/* application / window icon (lowest ID -> the shell's file icon) */
1 ICON "vordr.ico"

DLG_UNLOCK DIALOGEX 0, 0, 320, 104
STYLE  WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Unlock vault"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Vault file:", -1, 12, 12, 50, 10
    LTEXT           "(no vault selected)", IDC_U_PATH, 66, 12, 242, 10
    EDITTEXT        IDC_U_PW, 12, 40, 296, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "Unlock", IDC_U_UNLOCK, 254, 70, 54, 18, BS_OWNERDRAW
    LTEXT           "", IDC_U_STATUS, 12, 74, 232, 24
END

DLG_VAULT DIALOGEX 0, 0, 426, 350
CAPTION "Vordr - Vault"
STYLE DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    PUSHBUTTON "+", IDC_V_ADD, 8, 42, 16, 16, BS_OWNERDRAW
    PUSHBUTTON "e", IDC_V_EDIT, 8, 61, 16, 16, BS_OWNERDRAW
    PUSHBUTTON "-", IDC_V_REMOVE, 8, 266, 16, 16, BS_OWNERDRAW
    LISTBOX IDC_V_LIST, 30, 10, 116, 280, LBS_SORT | LBS_OWNERDRAWVARIABLE | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    EDITTEXT IDC_V_SEARCH, 30, 292, 116, 13, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER, 0
    CONTROL "", IDC_V_HEADER, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 158, 6, 216, 42
    PUSHBUTTON "", IDC_V_FAV, 378, 12, 16, 14, BS_OWNERDRAW
    PUSHBUTTON "", IDC_V_OVFL, 398, 12, 16, 14, BS_OWNERDRAW
    LTEXT "Title", IDC_V_TITLELBL, 158, 14, 44, 10
    EDITTEXT IDC_V_TITLE, 206, 13, 210, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER , 0
    LTEXT "", IDC_V_TIMES, 158, 332, 198, 10
    PUSHBUTTON "+ Add field", IDC_V_ADDFIELD, 158, 292, 64, 14, BS_OWNERDRAW
    PUSHBUTTON "Save", IDC_V_SAVE, 362, 292, 54, 14, BS_OWNERDRAW
    PUSHBUTTON "Lock", IDC_V_LOCK, 362, 320, 54, 18, BS_OWNERDRAW
    CONTROL "", IDC_V_MBACK, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 0, 0, 426, 350
    LTEXT "Settings", IDC_V_MTITLE, 30, 16, 200, 14
    LTEXT "Password policy", IDC_V_MPOLL, 30, 44, 360, 10
    LTEXT "Minimum length:", IDC_V_MLENL, 44, 60, 120, 10
    EDITTEXT IDC_V_MLEN, 170, 59, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    LTEXT "Minimum character types (1-4):", IDC_V_MCLSL, 44, 78, 120, 10
    EDITTEXT IDC_V_MCLS, 170, 77, 36, 11, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER , 0
    PUSHBUTTON "", IDC_V_MTPM, 170, 115, 20, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "TPM Unlock", IDC_V_MTPML, 30, 115, 56, 10
    PUSHBUTTON "i", IDC_V_MTPMINFO, 70, 115, 8, 8, BS_OWNERDRAW | NOT WS_TABSTOP
    LTEXT "Color scheme", IDC_V_MTHEMEL, 30, 140, 90, 10
    PUSHBUTTON "Dark", IDC_V_MTHEME, 130, 138, 96, 14, BS_OWNERDRAW
    LTEXT "Layout", IDC_V_MLAYOUTL, 30, 162, 90, 10
    PUSHBUTTON "Comfortable", IDC_V_MLAYOUT, 130, 160, 96, 14, BS_OWNERDRAW
    PUSHBUTTON "=", IDC_V_MENU, 8, 11, 16, 16, BS_OWNERDRAW
}

DLG_CREATE DIALOGEX 0, 0, 228, 108
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vordr - Create vault"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_C_PW, 16, 24, 176, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON      "i", IDC_C_INFO, 198, 23, 14, 14, BS_OWNERDRAW | NOT WS_TABSTOP
    CONTROL         "", IDC_C_PWBAR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 40, 176, 3
    EDITTEXT        IDC_C_PW2, 16, 52, 176, 11, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER, 0
    CONTROL         "", IDC_C_PW2BAR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 16, 68, 176, 3
    PUSHBUTTON      "Create", IDOK, 158, 82, 54, 18, BS_OWNERDRAW
END

DLG_MSG DIALOGEX 0, 0, 268, 142
CAPTION "Vordr"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    LTEXT "", IDC_M_TEXT, 20, 18, 228, 84, 0
    PUSHBUTTON "OK", IDC_M_OK, 132, 112, 56, 22, BS_OWNERDRAW
    PUSHBUTTON "Cancel", IDC_M_NO, 192, 112, 56, 22, BS_OWNERDRAW
}

DLG_ABOUT DIALOGEX 0, 0, 272, 132
CAPTION "About Vordr"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    CONTROL "", IDC_A_ICON, "Static", SS_ICON | WS_CHILD | WS_VISIBLE , 22 , 24 , 24 , 24
    LTEXT "", IDC_A_TEXT, 80, 24, 172, 78
    PUSHBUTTON "OK", IDC_A_OK, 214, 104, 56, 22, BS_OWNERDRAW
}

DLG_IMGVIEW DIALOGEX 0, 0, 400, 322
CAPTION "Vordr - Image"
STYLE DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    CONTROL "", IDC_IV_PIC, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 8, 8, 384, 282
    PUSHBUTTON "Export", IDC_IV_EXPORT, 280, 298, 54, 18, BS_OWNERDRAW
    PUSHBUTTON "Close", IDOK, 338, 298, 54, 18, BS_OWNERDRAW
}

DLG_PWREAD DIALOGEX 0, 0, 440, 250
CAPTION "Vordr - Read password"
STYLE DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI"
{
    CONTROL "", IDC_PR_COLOR, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 12, 12, 416, 34
    CONTROL "", IDC_PR_LEGEND, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 12, 50, 416, 12
    EDITTEXT IDC_PR_PHON, 12, 68, 416, 152, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_BORDER, 0
    PUSHBUTTON "Close", IDOK, 374, 226, 54, 16, BS_OWNERDRAW
}

1 VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L            /* VOS_NT_WINDOWS32 */
 FILETYPE       0x1L                /* VFT_APP */
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"           /* US English (0x0409), Unicode (1200) */
        BEGIN
            VALUE "CompanyName",      "Thomas Smistad"
            VALUE "FileDescription",  "Vordr - hardened password manager (AES-256-GCM + Argon2id)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "vordr"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Thomas Smistad"
            VALUE "OriginalFilename", "vordr.exe"
            VALUE "ProductName",      "Vordr"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
